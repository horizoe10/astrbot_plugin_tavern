{
  "security": {
    "description": "权限与群范围",
    "type": "object",
    "items": {
      "admin_ids": {
        "description": "开团管理员 ID",
        "type": "list",
        "hint": "只有这些真实平台用户 ID 可以开启、暂停、继续、关闭、读档或回滚。请填写字符串形式的 QQ 号/OpenID。",
        "default": []
      },
      "allowed_group_ids": {
        "description": "允许群 ID",
        "type": "list",
        "hint": "可留空；已配置的管理员首次在目标群发送 /团 开启 时会自动识别并加入，然后显示副本选择。也可手动填写群号或平台群 OpenID。",
        "default": []
      },
      "require_group_whitelist": {
        "description": "强制群白名单",
        "type": "bool",
        "default": true
      },
      "unauthorized_command_behavior": {
        "description": "未授权管理命令",
        "type": "string",
        "options": [
          "silent",
          "deny"
        ],
        "labels": [
          "静默拦截",
          "回复无权限"
        ],
        "default": "silent"
      },
      "public_status": {
        "description": "参与者可查看状态",
        "type": "bool",
        "default": true
      }
    }
  },
  "model": {
    "description": "叙事模型",
    "type": "object",
    "items": {
      "provider_id": {
        "description": "叙事模型",
        "type": "string",
        "_special": "select_provider",
        "hint": "留空则使用当前群会话所选模型。",
        "default": ""
      },
      "fallback_provider_1_id": {
        "description": "第一备用模型",
        "type": "string",
        "_special": "select_provider",
        "hint": "主模型不可用时首先尝试；留空可跳过。",
        "default": ""
      },
      "fallback_provider_2_id": {
        "description": "第二备用模型",
        "type": "string",
        "_special": "select_provider",
        "hint": "按编号依次回退；留空可跳过。",
        "default": ""
      },
      "fallback_provider_3_id": {
        "description": "第三备用模型",
        "type": "string",
        "_special": "select_provider",
        "hint": "按编号依次回退；留空可跳过。",
        "default": ""
      },
      "fallback_provider_4_id": {
        "description": "第四备用模型",
        "type": "string",
        "_special": "select_provider",
        "hint": "按编号依次回退；留空可跳过。",
        "default": ""
      },
      "image_caption_provider_id": {
        "description": "图片转述模型",
        "type": "string",
        "_special": "select_provider",
        "hint": "用于把带 t 前缀消息中的图片转成客观文字，再交给叙事模型。留空时带图行动会被明确拒绝。",
        "default": ""
      },
      "image_caption_prompt": {
        "description": "图片转述提示词",
        "type": "text",
        "default": "请用简洁、客观的中文描述图片中与角色行动、场景、物品、人物姿态和可见文字有关的信息。不要猜测看不见的事实。"
      },
      "max_images_per_turn": {
        "description": "单回合图片上限",
        "type": "int",
        "hint": "只读取带 t 前缀的当前玩家消息中的图片。",
        "default": 4
      },
      "temperature": {
        "description": "叙事随机度",
        "type": "float",
        "hint": "建议 0.4—0.5，可减少结构修复与额外模型请求。",
        "default": 0.5
      },
      "max_tokens": {
        "description": "单次最大输出 Tokens",
        "type": "int",
        "hint": "故事正文遵循副本当前的极简、平衡或史诗模式；史诗模式需要为正文、对白与选项保留更充足的输出空间。",
        "default": 1400
      },
      "request_timeout_seconds": {
        "description": "模型超时秒数",
        "type": "int",
        "default": 120
      },
      "json_repair_attempts": {
        "description": "结构修复次数",
        "type": "int",
        "default": 1
      },
      "generation_budget_total_seconds": {
        "description": "整回合生成预算秒数",
        "type": "int",
        "hint": "包含正文、结构修复、备用模型切换与最终校验；达到预算后不会提交半个回合。",
        "default": 180
      },
      "generation_budget_max_calls": {
        "description": "整回合最大模型调用次数",
        "type": "int",
        "default": 3
      },
      "generation_budget_per_call_seconds": {
        "description": "单次调用超时上限",
        "type": "int",
        "hint": "每个叙事模型的独立等待上限；超时后才会尝试已配置的备用模型。",
        "default": 90
      },
      "generation_budget_max_fallbacks": {
        "description": "整回合备用模型切换上限",
        "type": "int",
        "default": 1
      }
    }
  },
  "runtime": {
    "description": "运行规则",
    "type": "object",
    "items": {
      "default_world_slug": {
        "description": "新副本默认世界包",
        "type": "string",
        "hint": "仅作为控制台建立副本时的初始选择；/团 开启 仍要求明确选择副本。",
        "default": "thirteenth-seat-new-era"
      },
      "trigger_prefix": {
        "description": "剧情触发前缀",
        "type": "string",
        "hint": "默认 t。只有“前缀 + 空格 + 内容”才会进入开团叙事与记忆，普通群聊完全忽略。",
        "default": "t"
      },
      "two_phase_checks": {
        "description": "严格两阶段行动判定",
        "type": "bool",
        "hint": "模型先申请检定，插件生成不可篡改的骰点，再由模型叙述结果。",
        "default": true
      },
      "max_input_chars": {
        "description": "玩家单次输入上限",
        "type": "int",
        "default": 2000
      },
      "max_output_chars": {
        "description": "单次回复上限",
        "type": "int",
        "default": 5000
      },
      "enforce_mobile_output": {
        "description": "手机端可读输出约束",
        "type": "bool",
        "hint": "开启后故事正文仍严格遵循副本当前的极简、平衡或史诗模式；每个选项（含括号）最多 50 字并保持当前行动者一致。",
        "default": true
      },
      "qqbot_markdown_enabled": {
        "description": "自定义平台实例使用 Markdown",
        "type": "bool",
        "hint": "全部 BOT 文本先生成 Markdown 标准载荷；已知 QQ 官方实时回复、事件分段、主动通知和队列续发会自动携带 Markdown 标志。仅当自定义平台实例 ID 无法识别适配器类型时启用此开关；不支持 Markdown 的平台会在最终适配层降级为同源纯文本。",
        "default": true
      },
      "recent_turns": {
        "description": "带入最近回合数",
        "type": "int",
        "hint": "默认 6；长期事实由记忆与故事账本补充。",
        "default": 6
      },
      "memory_limit": {
        "description": "每轮检索记忆数",
        "type": "int",
        "hint": "默认 6；锁定事实仍按世界策略优先进入上下文。",
        "default": 6
      },
      "user_cooldown_seconds": {
        "description": "同一玩家冷却秒数",
        "type": "float",
        "default": 1.5
      },
      "auto_snapshot_interval": {
        "description": "自动快照间隔回合",
        "type": "int",
        "default": 5
      },
      "story_generation_reminder_enabled": {
        "description": "故事生成等待提醒",
        "type": "bool",
        "hint": "开启后，故事仍在生成时按固定间隔发送简短等待进度；完成、失败、取消或进入恢复后立即停止。",
        "default": true
      },
      "story_generation_reminder_interval_seconds": {
        "description": "故事生成提醒间隔（秒）",
        "type": "int",
        "hint": "范围 30—600 秒，必须为 15 秒的倍数；新生成流程会冻结当时设置，运行中修改不会改变该次提醒序列。",
        "default": 60
      },
      "ooc_prefixes": {
        "description": "场外发言前缀",
        "type": "list",
        "default": [
          "【OOC】",
          "[OOC]",
          "OOC:"
        ]
      },
      "time_rules": {
        "description": "全局时间与流程默认值",
        "type": "object",
        "hint": "世界模板可覆盖这些值，新建副本会复制快照；留空或 -1 表示不限时，0 非法。",
        "items": {
          "card_code_ttl_seconds": {
            "description": "私聊建卡码有效秒数",
            "type": "int",
            "default": 1800
          },
          "card_draft_ttl_seconds": {
            "description": "角色卡草稿保留秒数",
            "type": "int",
            "default": 604800
          },
          "card_completion_timeout_seconds": {
            "description": "等待完成建卡秒数",
            "type": "int",
            "default": -1
          },
          "preparation_timeout_seconds": {
            "description": "准备大厅最长秒数",
            "type": "int",
            "default": -1
          },
          "ready_timeout_seconds": {
            "description": "玩家准备确认秒数",
            "type": "int",
            "default": -1
          },
          "turn_timeout_seconds": {
            "description": "个人回合秒数",
            "type": "int",
            "default": -1
          },
          "turn_reminder_seconds": {
            "description": "回合提前提醒秒数",
            "type": "int",
            "default": -1
          },
          "max_consecutive_timeouts": {
            "description": "连续超时转候补次数",
            "type": "int",
            "default": -1
          },
          "standby_timeout_seconds": {
            "description": "候补自动退场秒数",
            "type": "int",
            "default": -1
          },
          "delegation_ttl_seconds": {
            "description": "代控授权有效秒数",
            "type": "int",
            "default": -1
          },
          "vote_round_one_seconds": {
            "description": "第一轮集体投票秒数",
            "type": "int",
            "default": -1
          },
          "vote_round_two_seconds": {
            "description": "第二轮集体投票秒数",
            "type": "int",
            "default": -1
          },
          "vote_reminder_seconds": {
            "description": "投票提前提醒秒数",
            "type": "int",
            "default": -1
          },
          "all_idle_pause_seconds": {
            "description": "全员无互动后自动暂停秒数",
            "type": "int",
            "default": -1
          },
          "pause_stops_clock": {
            "description": "暂停期间停止计时",
            "type": "bool",
            "default": true
          },
          "announce_timeouts": {
            "description": "在群内公布超时与提醒",
            "type": "bool",
            "default": false
          },
          "turn_timeout_action": {
            "description": "个人回合超时处理",
            "type": "string",
            "options": [
              "skip",
              "hold"
            ],
            "labels": [
              "跳过并累计超时",
              "保留行动权"
            ],
            "default": "hold"
          },
          "card_timeout_action": {
            "description": "建卡超时处理",
            "type": "string",
            "options": [
              "standby",
              "release",
              "remind"
            ],
            "labels": [
              "转候补",
              "释放席位",
              "仅提醒"
            ],
            "default": "remind"
          },
          "ready_timeout_action": {
            "description": "准备超时处理",
            "type": "string",
            "options": [
              "standby",
              "remind"
            ],
            "labels": [
              "转候补",
              "仅提醒"
            ],
            "default": "remind"
          }
        }
      }
    }
  },
  "advanced": {
    "description": "高级设置",
    "type": "object",
    "items": {
      "audit_retention_days": {
        "description": "审计日志保留天数",
        "type": "int",
        "default": 90
      },
      "store_model_payloads": {
        "description": "保存原始模型结构",
        "type": "bool",
        "hint": "排错用途，可能增加数据库体积；默认关闭。",
        "default": false
      },
      "debug": {
        "description": "调试日志",
        "type": "bool",
        "default": false
      }
    }
  },
  "token_quota": {
    "description": "Token 配额默认值",
    "type": "object",
    "items": {
      "enabled": {
        "description": "默认启用配额",
        "type": "bool",
        "hint": "开启后，新建副本若尚未配置任何 Token 配额策略，将按本组默认值自动创建策略；关闭则保持“无配额不限量”的运行时行为（已有策略不受影响）。",
        "default": false
      },
      "window_seconds": {
        "description": "滚动窗口秒数",
        "type": "int",
        "hint": "配额统计的时间窗口，例如 86400 = 按最近 24 小时累计。",
        "default": 86400
      },
      "token_limit": {
        "description": "窗口内 Token 上限",
        "type": "int",
        "hint": "窗口内累计消耗超过该值将拒绝新的模型请求。",
        "default": 400000
      }
    }
  },
  "auto_backup": {
    "description": "自动备份",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用自动备份",
        "type": "bool",
        "hint": "开启后，插件按固定间隔在 data_dir/exports 下导出完整备份 ZIP（bundle.json + catalog.sqlite3 + 各群独立存档），并只保留最近 keep_count 份。默认关闭。",
        "default": false
      },
      "interval_hours": {
        "description": "备份间隔（小时）",
        "type": "float",
        "hint": "两次自动备份的最小间隔，最小 1 小时，最大 720 小时（30 天）。",
        "default": 24
      },
      "keep_count": {
        "description": "保留份数",
        "type": "int",
        "hint": "自动备份只保留最近 N 份，更早的会被自动清理（手动导出的备份不受影响）。",
        "default": 7
      }
    }
  },
  "webhook": {
    "description": "Webhook 事件通知",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用 Webhook 通知",
        "type": "bool",
        "hint": "开启后，开团内部事件（回合/世界/会话/备份等）会以 POST JSON 推送到下方地址，默认全部事件；可填写 events 过滤。",
        "default": false
      },
      "urls": {
        "description": "推送地址列表",
        "type": "list",
        "hint": "每个地址都会收到事件推送。仅支持 HTTPS/HTTP POST，请求体为 JSON 对象，包含 event / at / data 字段。",
        "default": []
      },
      "secret": {
        "description": "签名密钥（可选）",
        "type": "string",
        "hint": "填写后，每次推送会附加 X-Tavern-Signature: sha256=<hex> 头（对请求体做 HMAC-SHA256），接收方可据此校验来源。",
        "default": ""
      },
      "events": {
        "description": "事件类型过滤（留空＝全部）",
        "type": "list",
        "hint": "只推送列出的 type（如 turn、session、world、backup、settings、vote、inspiration、character）；留空推送全部。",
        "default": []
      },
      "timeout_seconds": {
        "description": "推送超时（秒）",
        "type": "float",
        "hint": "单次推送的最长等待时间，默认 10 秒。",
        "default": 10
      }
    }
  },
  "remote_panel": {
    "description": "独立 Web 面板",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用独立 Web 面板",
        "type": "bool",
        "hint": "默认开启，并由下方地址/端口直接托管完整的 321开团 WebUI 控制台（默认仅本机 127.0.0.1），不依赖 AstrBot 管理后台页面。首次本机登录使用 admin/admin；已有自定义密码不会被覆盖。",
        "default": true
      },
      "host": {
        "description": "监听地址",
        "type": "string",
        "hint": "默认 127.0.0.1（仅本机）。公网访问二选一：① 有域名时改为 0.0.0.0 并配 HTTPS 反代；② 无域名直连 IP 时改为 0.0.0.0 并开启 allow_insecure_http（需自行放行端口，明文传输风险自负，详见 README 公网访问章节）。",
        "default": "127.0.0.1"
      },
      "port": {
        "description": "监听端口",
        "type": "int",
        "hint": "独立面板的 TCP 端口（1—65535）。",
        "default": 8766
      },
      "allow_insecure_http": {
        "description": "允许明文 HTTP 登录",
        "type": "bool",
        "hint": "默认关闭：非本机访问时要求 HTTPS（反代/隧道），不开则直接拒绝连接。无域名直连服务器 IP 部署时必须开启本项才能从外部访问；开启后密码与令牌明文传输，请先修改默认管理员密码，风险自负。",
        "default": false
      },
      "external_scheme": {
        "description": "外部访问协议",
        "type": "string",
        "hint": "经 HTTPS 反向代理/隧道访问时设为 https；此时登录 Cookie 强制携带 Secure。默认 http（仅本机）。",
        "default": "http"
      },
      "secure_cookie": {
        "description": "强制登录 Cookie 携带 Secure 标记",
        "type": "bool",
        "hint": "留空时自动跟随 external_scheme；显式设为 false 且 external_scheme=https 时拒绝启动（矛盾配置）。",
        "default": null
      },
      "trusted_proxy_cidrs": {
        "description": "可信反向代理来源段",
        "type": "list",
        "hint": "仅来自这些 CIDR 的直连对端才会读取 X-Forwarded-Proto 等转发头；默认仅回环。",
        "default": [
          "127.0.0.1",
          "::1"
        ]
      },
      "public_url": {
        "description": "网页建卡公网访问地址",
        "type": "string",
        "hint": "网页建卡链接的前缀（含协议，结尾不带斜杠），例如 https://www.example.com。有域名填域名；无域名直连 IP 可填 http://服务器IP:8766。留空时使用 http://监听地址:端口，仅本机/内网可访问。",
        "default": ""
      }
    }
  }
}
